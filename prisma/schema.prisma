// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Comprador {
  id              Int      @id @default(autoincrement())
  dni             String   @unique
  cuilCuit        String   @unique
  apellido        String
  nombre          String
  sexo            String?
  direccion       String
  mail            String   @unique
  celular         String
  fechaNacimiento DateTime
  nacionalidad    String
  condicionIva    String
  clerkUserId     String   @unique // UserID (Clerk) 
  isDeleted       Boolean  @default(false)
  pedidos         Pedido[]
  carrito         Carrito?
}

model Pedido {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  compradorId Int
  comprador   Comprador @relation(fields: [compradorId], references: [id])
  vendedorId  Int      // Referencia a la Seller App
  productosId Int[]    // Lista de IDs de productos
  monto       Float
  estado      String
  envioId     Int?     // Referencia a la Shipping App
}

model Carrito {
  id          Int           @id @default(autoincrement())
  compradorId Int           @unique  // un solo carrito activo por comprador
  comprador   Comprador     @relation(fields: [compradorId], references: [id])
  items       CarritoItem[]
  creadoEn    DateTime      @default(now())
  actualizadoEn DateTime    @updatedAt
}

model CarritoItem {
  id         Int     @id @default(autoincrement())
  carritoId  Int
  carrito    Carrito @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId Int     // ID del producto en Seller App
  nombre     String  // Desnormalizado: copiamos el nombre para no depender de Seller App
  precio     Float   // Desnormalizado: precio al momento de agregar
  imagen     String?
  cantidad   Int     @default(1)
}