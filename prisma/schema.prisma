// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Comprador {
  id              String   @id @default(cuid())
  dni             String   @unique
  cuilCuit        String   @unique
  apellido        String
  nombre          String
  sexo            String?
  direccion       String
  mail            String   @unique
  celular         String
  fechaNacimiento DateTime
  nacionalidad    String
  condicionIva    String
  clerkUserId     String   @unique
  isDeleted       Boolean  @default(false)
  perfilCompleto  Boolean  @default(false)
  createdAt       DateTime @default(now())
  pedidos         Pedido[]
  carrito         Carrito?
}

model Pedido {
  id          String    @id @default(cuid())
  fecha       DateTime  @default(now())
  compradorId String
  comprador   Comprador @relation(fields: [compradorId], references: [id])
  vendedorId  String
  productosId String[]
  monto       Float
  subtotalProductos Float?
  costoEnvio        Float?
  estado      String
  envioId     String?
}

model Carrito {
  id            String        @id @default(cuid())
  compradorId   String        @unique
  comprador     Comprador     @relation(fields: [compradorId], references: [id])
  items         CarritoItem[]
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
}

model CarritoItem {
  id         String  @id @default(cuid())
  carritoId  String
  carrito    Carrito @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId String
  nombre     String
  precio     Float
  imagen     String?
  cantidad   Int     @default(1)
  vendedorId String
}